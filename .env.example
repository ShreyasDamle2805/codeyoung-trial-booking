# Copy to .env in the repository root. Restart the server after changes.
PORT=3001
HOST=127.0.0.1
# Set to http://localhost:5173 when using npm run dev.
APP_ORIGIN=http://localhost:3001

# preview requires no setup. smtp delivers queued confirmations to the configured server.
MAIL_MODE=preview
MAIL_FROM=Codeyoung Trial Demo <trial@example.com>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
# SMTP_USER=
# SMTP_PASSWORD=
# Optional: ten unique comma-separated mentor addresses, in mentor ID order.
# Default example.com addresses are suitable for a local Mailpit inbox.
# MENTOR_EMAILS=
