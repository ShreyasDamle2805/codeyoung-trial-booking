{
  "name": "codeyoung-trial-booking",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "node --test backend/test/*.test.js",
    "test:browser": "playwright test",
    "lint": "eslint backend/src backend/test frontend/src tools tests *.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm test && npm run build && npm run test:browser",
    "mail:status": "node tools/mail-outbox.mjs",
    "mail:retry": "node tools/mail-outbox.mjs --retry-failed",
    "manual:server": "node tools/manual-server.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "smtp-server": "^3.19.13"
  }
}
